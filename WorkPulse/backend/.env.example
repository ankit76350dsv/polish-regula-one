# Server
PORT=8085
NODE_ENV=development

# Which network connections to answer on.
# 0.0.0.0 = all of them, so the API works on http://localhost:8085 AND on
# http://<this-machine-ip>:8085 for other people on the same network.
# Use 127.0.0.1 to keep it reachable from this computer only.
BIND_HOST=0.0.0.0

# MongoDB
# WorkPulse shares the SAME MongoDB database as the rest of the RegulaOne
# platform. It needs read access to the shared `users` collection (identity)
# and to SafeWork's `safework_employees` collection (clock-in eligibility),
# and it writes its own `workplus_*` collections into the same database.
MONGODB_URI=mongodb://localhost:27017/safework

# CORS — which websites may call this API from a browser.
# The WorkPulse frontend runs on :3005 in development.
# While NODE_ENV is not "production", the same PORT is also accepted on this computer and on
# a private office/home network (10.x, 172.16-31.x, 192.168.x), so a teammate opening
# http://<this-machine-ip>:3005 is not refused. In production ONLY the list below is
# accepted. See src/config/corsOptions.js.
CORS_ORIGIN=http://localhost:3005

# RegulaOne integration — central identity / SSO API base URL (Java, :8080)
REGULAONE_API_URL=http://localhost:8080

# Who may use WorkPulse.
# The RegulaOne /api/auth/me response contains a "permissions" list for the
# logged-in user. Only the roles below are recognised; what each role may DO is
# decided by the capability table in src/config/permissions.js.
# Leave this unset to recognise every role WorkPulse has a policy for.
WORKPULSE_ALLOWED_PERMISSIONS=WORKPULSE_ADMIN,WORKPULSE_HR_ADMIN,WORKPULSE_AUDITOR,WORKPULSE_EMPLOYEE

# AWS Cognito — token verification (shared user pool with the rest of the platform)
# A comma-separated list of app-client ids is supported (web + mobile clients).
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-web-client-id,your-mobile-client-id
AWS_COGNITO_TOKEN_USE=id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Scheduled jobs (cron) — set to "false" to disable the WorkPulse cron jobs
# (useful when running multiple instances so jobs only run on one node).
ENABLE_CRON_JOBS=true
