# ── safeWork Frontend — LAN (served on the machine IP) ───────────────────────
# The app is opened at http://192.168.20.38:3002, so both backend URLs are pinned to
# that same host: VITE_API_URL is the RegulaOne identity backend (port 8080), and
# VITE_SAFEWORK_API_URL is safeWork's own backend (port 8082).
# When the machine IP changes, update the IP here (and in the backend CORS lists).
VITE_API_URL=http://192.168.20.38:8080
VITE_SAFEWORK_API_URL=http://192.168.20.38:8082
