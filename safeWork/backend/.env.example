# Server
PORT=8082
NODE_ENV=development

# Which network connections to answer on.
# 0.0.0.0 = all of them, so the API works on http://localhost:8082 AND on
# http://<this-machine-ip>:8082 for other people on the same network.
# Use 127.0.0.1 to keep it reachable from this computer only.
BIND_HOST=0.0.0.0

# MongoDB
MONGODB_URI=mongodb://localhost:27017/safework

# JWT
JWT_SECRET=your-very-secure-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS — which websites may call this API from a browser.
# The SafeWork frontend runs on :3002 in development.
# While NODE_ENV is not "production", the same PORT is also accepted on this computer and on
# a private office/home network (10.x, 172.16-31.x, 192.168.x), so a teammate opening
# http://<this-machine-ip>:3002 is not refused. In production ONLY the list below is
# accepted. See src/config/corsOptions.js.
CORS_ORIGIN=http://localhost:3002

# RegulaOne integration — user/identity API base URL.
# This is where SafeWork asks "who is this user and what may they do?", so it
# must be correct in every environment. The code accepts either spelling
# (REGULAONE_API_URL or the older REGULA_ONE_API_URL); prefer this one.
REGULAONE_API_URL=http://localhost:8080

# Who may use SafeWork.
# The RegulaOne /api/auth/me response contains a "permissions" list for the
# logged-in user. A request is allowed ONLY if that list contains at least one
# of the permissions below. Every other permission is refused with 403.
# Comma-separated, no spaces needed.
SAFEWORK_ALLOWED_PERMISSIONS=SAFEWORK_ADMIN,SAFEWORK_HR_MANAGER,SAFEWORK_AUDITOR

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AWS S3 — Compliance document storage (must be in EU region for GDPR)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=your-safework-documents-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
